GOOGLE_MAPS_API_KEY=

# Photo Studio (desktop back-of-house tool) — see studio/README.md
# Gemini API key from https://aistudio.google.com/app/apikey (leave empty for mock mode)
GEMINI_API_KEY=
# Optional: watch a different folder for Flow downloads (default ~/Downloads)
STUDIO_DOWNLOADS_DIR=
# Set to 1 to push automatically after each approved commit
STUDIO_AUTO_PUSH=0
